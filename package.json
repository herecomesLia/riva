{
  "name": "riva",
  "private": true,
  "scripts": {
    "client:dev": "pnpm --filter @riva/client --fail-if-no-match dev",
    "client:dev:mock": "pnpm --filter @riva/client --fail-if-no-match dev:mock",
    "client:api:generate": "pnpm --filter @riva/client --fail-if-no-match api:generate",
    "client:build": "pnpm --filter @riva/client --fail-if-no-match build",
    "client:build:mock": "pnpm --filter @riva/client --fail-if-no-match build:mock",
    "client:preview": "pnpm --filter @riva/client --fail-if-no-match preview",
    "client:storybook": "pnpm --filter @riva/client --fail-if-no-match storybook",
    "client:storybook:build": "pnpm --filter @riva/client --fail-if-no-match build-storybook",
    "client:lint": "pnpm --filter @riva/client --fail-if-no-match lint",
    "client:test": "pnpm --filter @riva/client --fail-if-no-match test",
    "client:test:all": "pnpm --filter @riva/client --fail-if-no-match test:all",
    "server:dev": "uv run --locked --directory apps/server riva dev --env-file ../../.env",
    "server:db:setup": "uv run --locked --directory apps/server riva db setup --env-file ../../.env",
    "server:db:reset": "uv run --locked --directory apps/server riva db reset --env-file ../../.env",
    "server:format": "uv run --locked --directory apps/server ruff check --select I --fix && uv run --locked --directory apps/server ruff format",
    "server:format:check": "uv run --locked --directory apps/server ruff check --select I && uv run --locked --directory apps/server ruff format --check",
    "server:test": "uv run --locked --directory apps/server pytest",
    "format:prettier": "prettier --write --ignore-unknown .",
    "format:prettier:check": "prettier --check --ignore-unknown .",
    "format": "pnpm run format:prettier && pnpm run server:format",
    "format:check": "pnpm run format:prettier:check && pnpm run server:format:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  },
  "type": "module"
}
