{
  "name": "riva",
  "private": true,
  "scripts": {
    "client:dev": "pnpm --filter @riva/client --fail-if-no-match dev",
    "client:dev:mock": "pnpm --filter @riva/client --fail-if-no-match dev:mock",
    "client:build": "pnpm --filter @riva/client --fail-if-no-match build",
    "client:build:mock": "pnpm --filter @riva/client --fail-if-no-match build:mock",
    "client:lint": "pnpm --filter @riva/client --fail-if-no-match lint",
    "client:preview": "pnpm --filter @riva/client --fail-if-no-match preview",
    "client:test": "pnpm --filter @riva/client --fail-if-no-match test",
    "client:test:mock": "pnpm --filter @riva/client --fail-if-no-match test:mock",
    "client:test:all": "pnpm --filter @riva/client --fail-if-no-match test:all",
    "client:test:watch": "pnpm --filter @riva/client --fail-if-no-match test:watch",
    "client:test:watch:mock": "pnpm --filter @riva/client --fail-if-no-match test:watch:mock",
    "client:test:e2e": "pnpm --filter @riva/client --fail-if-no-match test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  },
  "type": "module"
}
