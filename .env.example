# Server bind address.
RIVA_HOST=127.0.0.1
RIVA_PORT=7482

# Logging.
RIVA_LOG_LEVEL=info
RIVA_LOG_FORMAT=console

# Optional LangSmith tracing. Load LANGSMITH_* into the process environment.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=riva-development
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# PostgreSQL connection.
RIVA_DATABASE_URL=postgresql+psycopg://riva:riva@localhost:5432/riva
# Health timeout and TTL in seconds; TTL 0 disables caching.
RIVA_DATABASE_HEALTH_TIMEOUT_SECONDS=2
RIVA_DATABASE_HEALTH_TTL_SECONDS=5

# Optional OpenAI-compatible LLM runtime.
# Leave RIVA_LLM_BASE_URL empty to disable LLM integration.
RIVA_LLM_MODELS_DEFAULT_ID=
RIVA_LLM_MODELS_DEFAULT_USE_RESPONSES_API=false
RIVA_LLM_MODELS_REASONING_ID=
RIVA_LLM_MODELS_REASONING_USE_RESPONSES_API=false
RIVA_LLM_API_KEY=
RIVA_LLM_BASE_URL=
# Health timeout and TTL in seconds; TTL 0 disables caching.
RIVA_LLM_HEALTH_TIMEOUT_SECONDS=5
RIVA_LLM_HEALTH_TTL_SECONDS=30


# Background task worker.
RIVA_TASKS_CONCURRENCY=4
RIVA_TASKS_SHUTDOWN_TIMEOUT_SECONDS=30

# Session signing and cookie policy.
# Replace this with a long random secret before running the server.
RIVA_SESSION_DIGEST_KEY=replace-with-a-long-random-secret

# Production cookie defaults assume HTTPS and no Domain attribute.
RIVA_SESSION_COOKIE_NAME=__Host-riva_session
# Local Development:
# RIVA_SESSION_COOKIE_NAME=riva_session
RIVA_SESSION_COOKIE_SECURE=true
# Local Development:
# RIVA_SESSION_COOKIE_SECURE=false
RIVA_SESSION_COOKIE_SAMESITE=lax
RIVA_SESSION_COOKIE_PATH=/

# Sliding idle timeout and refresh write throttle, in seconds.
RIVA_SESSION_IDLE_TIMEOUT_SECONDS=604800
RIVA_SESSION_REFRESH_INTERVAL_SECONDS=300

# CORS.
# Empty origins assume same-origin frontend/API deployment.
RIVA_CORS_ALLOWED_ORIGINS=
# Local Development with Vite:
# RIVA_CORS_ALLOWED_ORIGINS=http://localhost:5173
RIVA_CORS_ALLOW_CREDENTIALS=true
