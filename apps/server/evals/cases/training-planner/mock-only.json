  },
  "assertions": [
    { "path": "/action", "operator": "exact", "expected": "mockInterview" },
    { "path": "/round", "operator": "exact", "expected": "comprehensive" },
    { "path": "/difficulty", "operator": "exact", "expected": "pressure" },
    { "path": "/durationMinutes", "operator": "exact", "expected": 30 },
    { "path": "/focusAreas", "operator": "itemCount", "min": 0, "max": 3 }
